# Exemplo de variáveis de ambiente para execução local ou em CI/CD.
# Nunca versione credenciais reais; utilize perfis do Databricks CLI (`databricks auth login`)
# ou segredos do seu provedor de CI/CD.

# Perfil padrão do Databricks CLI (opcional; sobrescrito por --profile ou env/<env>.yaml)
DATABRICKS_CONFIG_PROFILE=dev-workspace

# Alternativa para pipelines CI/CD headless (OAuth M2M ou Service Principal)
# DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.xx.azuredatabricks.net
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Diretório local de estado do GenieOps (histórico SQLite e backups de rollback)
GENIEOPS_STATE_DIR=.genieops

# Fase 2 — LLM-as-a-Judge plugável (opcional)
# Para provedor "databricks" (Foundation Model API / Unity Gateway via perfil CLI):
# GENIEOPS_JUDGE_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# Para provedor "openai" (endpoint OpenAI-compatible):
# GENIEOPS_JUDGE_BASE_URL=https://api.openai.com/v1
# GENIEOPS_JUDGE_API_KEY=
# GENIEOPS_JUDGE_MODEL=gpt-4o-mini
